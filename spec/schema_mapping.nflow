@require ../nexssflow
@db sqlite as local { path: ":memory:" }

@schema NoteWrite {
  Title string `json:"title" db:"title" validate:"required"`
  Completed bool `json:"completed" db:"is_done" default:"false"`
  Priority int `json:"priority" db:"priority"`
}
@dbmap local NoteWrite as notes

@pipeline setup
  db.exec @{ database: "local", query: "CREATE TABLE notes (id INTEGER PRIMARY KEY, title TEXT NOT NULL, is_done INTEGER NOT NULL DEFAULT 1, priority INTEGER NOT NULL DEFAULT 9)", args: [] }
@end
@pipeline insert_note
  :request-schema=NoteWrite
  db.insert @{ database: "local", schema: "NoteWrite", record: . }
@end
@pipeline read_note
  db.query_mapped @{ database: "local", schema: "NoteWrite", query: "SELECT title, is_done, priority FROM notes", args: [] }
  -> runtime.pick @{ field: "rows" }
@end
pipeline.setup
  -> { title: "First" }
  -> pipeline.insert_note
  -> pipeline.read_note

@assert: len(result) == 1
@assert: result[0].title == "First"
@assert: result[0].completed == false
@assert: result[0].priority == 9
